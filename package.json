{
  "name": "psnpp-gist",
  "version": "0.1.0",
  "private": true,
  "description": "Syncs PSNP+ game lists to a GitHub Gist, keeping them in sync across browsers and devices.",
  "type": "module",
  "scripts": {
    "build": "bun run build.ts",
    "check": "bun run typecheck && bun run lint",
    "format": "bunx prettier --write .",
    "lint": "bunx eslint src/",
    "typecheck": "bunx tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@prettier/plugin-xml": "3.4.2",
    "@types/bun": "1.3.14",
    "@types/tampermonkey": "5.0.5",
    "eslint": "10.4.0",
    "prettier": "3.8.3",
    "prettier-plugin-packagejson": "3.0.2",
    "typescript-eslint": "8.59.3"
  },
  "peerDependencies": {
    "typescript": "6.0.3"
  }
}
